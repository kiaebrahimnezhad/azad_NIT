{
  "compilerOptions": {
    "sourceMap": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "lib": ["ESNext"],
    "target": "es2022",
    "allowJs": true,
    "baseUrl": "./src",
    "moduleDetection": "force",
    "moduleResolution": "node",
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
