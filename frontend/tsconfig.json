{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "allowJs": true,
    "jsx": "react-jsx",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "typeRoots": [
      "node_modules/@types",
      "src/types"
    ],

    "sourceMap": true
  },

  "include": ["src"]
}
// رفع ایراد تایپ اسکریپت قدیمی که در پروژه های ری اکت ایجاد می شود و باعث می شود که تایپ اسکریپت نتواند فایل های JSX را به درستی شناسایی کند، با اضافه کردن گزینه "jsx": "react-jsx" در تنظیمات tsconfig.json حل می شود. این گزینه به تایپ اسکریپت می گوید که از نسخه جدید JSX استفاده کند که با React 17 و بالاتر سازگار است.